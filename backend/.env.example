# ==============================================================================
# NOVA AI Backend Configuration
# ==============================================================================

ENVIRONMENT=development

# Supabase Credentials (Found in Supabase Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# AI Provider API Keys (Set whichever you prefer; kept safely on backend!)
# Option 1: Google Gemini API (Recommended: ultra-fast, generous free tier)
GEMINI_API_KEY=your-gemini-api-key-here

# Option 2: OpenAI API
OPENAI_API_KEY=sk-...

# Option 3: Groq API (Blazing fast inference)
GROQ_API_KEY=gsk_...

# Default fallback model
DEFAULT_MODEL=nova-ai
